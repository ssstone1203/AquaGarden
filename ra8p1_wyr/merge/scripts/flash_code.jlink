// Program merge code MRAM only (no CONF/OTP). Run from merge/:
//   JLinkExe -CommanderScript scripts\flash_code.jlink
ScriptFile JLinkSettings.JLinkScript
device R7KA8P1KF_CPU0?BankAddr=0x12000000&Loader=RAMLess
si SWD
speed 5000
exec SetVerifyDownload = 0
r
loadfile Objects\merge_code.hex
r
exit
