          <Key>JL2CM3</Key>
          <Name>-U1089695894 -O78 -S2 -ZTIFSpeedSel5000 -A0 -C0 -JU1 -JI127.0.0.1 -JP0 -RST0 -N00("ARM CoreSight SW-DP") -D00(6BA02477) -L00(0) -TO18 -TC10000000 -TP21 -TDS8007 -TDT0 -TDC1F -TIEFFFFFFFF -TIP8 -TB1 -TFE0 -FO11 -FD22000000 -FC7800 -FN1 -FF0RA8P1_1M.FLM -FS02000000 -FL0100000 -FP0($$Device:R7KA8P1KF$Flash\RA8P1_1M.FLM)</Name>
