# AquaGarden 环境变量配置
# 复制此文件为 .env 并填入实际值

# ===========================================
# 阿里云 DashScope API
# ===========================================
# 阿里云 DashScope API Key（用于 LLM / TTS / ASR）
# 获取地址: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=your_api_key_here

# ===========================================
# 天气 API（可选）
# ===========================================
# 心知天气 API Key（用于获取真实天气信息）
# 获取地址: https://www.seniverse.com/
XINZHI_KEY=your_weather_key_here

# ===========================================
# 串口配置（后端读取 ROBOT_SERIAL_PORT）
# ===========================================
# 机械臂 RA6M5（Windows: COM16；Linux: /dev/ttyUSB0；Mac: /dev/cu.usbserial）
ROBOT_SERIAL_PORT=COM16
ROBOT_BAUDRATE=115200

# 示教仿射矩阵 npz（默认：仓库根下 model/calibration/teach_map.npz，由 target/clamp/collect_teach.py 生成）
# ROBOT_TEACH_MAP_PATH=G:/AquaGarden/model/calibration/teach_map.npz

# Agent DEBUG：键盘流程（与 DEBUG=1 python agent.py 一致：先模拟唤醒 Enter，再键盘对话）
# AGENT_DEBUG_KEYBOARD=1

# Agent 扩展：单文件 .pyc（须与运行后端的 Python 主版本一致，如 3.9 → *cpython-39.pyc；见 agent/pyc_loader.py）
# 模块需可选实现 parse_intent(text)->(task, params) 以及 infer(text, **ctx) 或 predict(text)
# AGENT_TRAINED_PYC=agent/__pycache__/my_engine.cpython-39.pyc

# ===========================================
# 摄像头配置
# ===========================================
# 摄像头索引（0 为默认摄像头）
CAMERA_INDEX=1

# ===========================================
# DEBUG 模式
# ===========================================
# 设置为 1 启用 DEBUG 模式（键盘输入代替语音）
DEBUG=0
