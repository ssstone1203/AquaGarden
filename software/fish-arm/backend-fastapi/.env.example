AQUAGARDEN_FASTAPI_PORT=8090
AQUAGARDEN_DATABASE_URL=sqlite:///./aquagarden.db
AQUAGARDEN_HARDWARE_SERIAL_ENABLED=true
# COM port is auto-detected (leave blank for auto). Set explicitly only if auto-detection fails.
# AQUAGARDEN_HARDWARE_SERIAL_PORT=COM3
AQUAGARDEN_HARDWARE_SERIAL_BAUD=115200
AQUAGARDEN_HARDWARE_SERIAL_PERSIST_INTERVAL_MS=1000
AQUAGARDEN_HARDWARE_SERIAL_RECONNECT_DELAY_MS=3000

# ---- 换电脑/换网络时只需修改这一行 ----
# 树莓派 bridge 地址，填写树莓派在当前局域网的 IP。
AQUAGARDEN_BRIDGE_BASE_URL=http://<RASPBERRY_PI_IP>:18080
# 摄像头 URL 自动从 AQUAGARDEN_BRIDGE_BASE_URL 派生（/video/rgb.mjpg），通常无需填写。
# AQUAGARDEN_RASPBERRY_PI_CAMERA_URL=
AQUAGARDEN_TANK_USB_CAMERA_ENABLED=true
AQUAGARDEN_TANK_USB_CAMERA_INDEX=0
AQUAGARDEN_TANK_USB_CAMERA_WIDTH=640
AQUAGARDEN_TANK_USB_CAMERA_HEIGHT=480
AQUAGARDEN_TANK_USB_CAMERA_FPS=10
AQUAGARDEN_TANK_USB_CAMERA_JPEG_QUALITY=80
AQUAGARDEN_TANK_YOLO_ENABLED=true
AQUAGARDEN_TANK_YOLO_WEIGHTS_PATH=model/yolo_fish/runs/yolo11n_fish_new/weights/best.pt
AQUAGARDEN_TANK_YOLO_CONFIDENCE=0.25
AQUAGARDEN_TANK_YOLO_IMAGE_SIZE=640
AQUAGARDEN_TANK_YOLO_EVERY_N_FRAMES=3
# 留空使用自动设备；可设为 cpu、0 等 Ultralytics 设备值。
AQUAGARDEN_TANK_YOLO_DEVICE=

# Replace these values before exposing the service outside a trusted LAN.
AQUAGARDEN_JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
AQUAGARDEN_DEVICE_UPLOAD_TOKEN=change-me

# Leave both blank to disable initial administrator creation.
AQUAGARDEN_ADMIN_USERNAME=
AQUAGARDEN_ADMIN_PASSWORD=
AQUAGARDEN_ADMIN_EMAIL=

# Dashboard AI assistant. Keep the real key only in backend-fastapi/.env or the process environment.
AQUAGARDEN_LLM_ENABLED=true
AQUAGARDEN_LLM_PROVIDER=anthropic
AQUAGARDEN_LLM_BASE_URL=https://api.kimi.com/coding
AQUAGARDEN_LLM_AUTH_MODE=bearer
AQUAGARDEN_LLM_API_KEY=
AQUAGARDEN_LLM_MODEL=kimi-for-coding
AQUAGARDEN_LLM_MAX_TOKENS=768
