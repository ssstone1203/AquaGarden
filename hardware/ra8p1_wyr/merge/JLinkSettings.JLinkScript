/***********************************************************************
* J-Link script for RA8P1 (Secure Debug). Keep _USE_RAMLESS_FLASH_DRIVER=0
* for Keil UL2V8M flash programming; use scripts/flash_code.jlink for RAMLess.
***********************************************************************/

__constant U32 _USE_RAMLESS_FLASH_DRIVER = 0;

int ConfigTargetSettings(void) {
  JLINK_SYS_Report("J-Link script: ConfigTargetSettings()");
  if (_USE_RAMLESS_FLASH_DRIVER != 0) {
    JLINK_SYS_Report("## Setting Device for flash driver that requires no RAM");
    JLINK_SetDevice("R7KA8P1KF_CPU0?BankAddr=0x12000000&Loader=RAMLess");
  }
  return 0;
}
