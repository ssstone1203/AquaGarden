[Unit]
Description=Load AquaGarden remoteproc firmware (OpenAMP SPI core)
Documentation=file:///opt/aqua/spi_com/openamp_core/README.md
After=local-fs.target
Before=aqua-rpmsgd.service

[Service]
Type=oneshot
; Bundled next to install_fixed_openamp_unit.sh so rsync of deploy/scripts/ updates /etc even when deploy/systemd on device is root-only/stale.
RemainAfterExit=yes
TimeoutStartSec=120s

ExecStartPre=/bin/sh -c 'cat /sys/class/remoteproc/remoteproc0/firmware > /run/aqua_prev_firmware.txt 2>/dev/null || true'
ExecStartPre=/bin/sh -c 'echo disabled > /sys/class/remoteproc/remoteproc0/recovery 2>/dev/null || true'
ExecStart=/opt/aqua/spi_com/deploy/scripts/aqua_openamp_load.sh
ExecStop=/bin/sh -c 'echo enabled > /sys/class/remoteproc/remoteproc0/recovery 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
